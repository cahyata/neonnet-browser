#include <winres.h>
#include "resource.h"

IDI_APP     ICON    "neonnet.ico"
IDR_CHROME  RCDATA  "..\\ui\\chrome.html"
IDR_NEWTAB  RCDATA  "..\\ui\\newtab.html"
IDR_HISTORY RCDATA  "..\\ui\\history.html"
IDR_BOOKMARKS RCDATA "..\\ui\\bookmarks.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NeonNet"
            VALUE "FileDescription", "NeonNet Browser"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "NeonNet"
            VALUE "OriginalFilename", "NeonNet.exe"
            VALUE "ProductName", "NeonNet"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
